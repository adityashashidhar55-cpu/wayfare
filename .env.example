# ── Core (required) ─────────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret

# Dedicated session-signing key. STRONGLY RECOMMENDED in production.
# Falls back to APP_SECRET when unset, but APP_SECRET is also sent over the
# wire as an OAuth client_secret — if it leaks, anyone can forge a session JWT
# for any user, including the OWNER_UNION_ID admin account.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=             # MySQL/TiDB connection string (mysql://user:pass@host:port/db)

# r31: on first boot the server creates the 40 tables from db/schema.sql and
# loads db/data/explore_places.mysql.sql.gz (526,142 places) if the database is
# empty. Both steps are idempotent and run AFTER the port is bound, so they
# never trip a platform health check. Set to 0 to manage the schema yourself.
AUTO_BOOTSTRAP=           # 0 disables first-boot schema + corpus loading

# TLS is added automatically for providers that require it (TiDB Cloud,
# PlanetScale, Aiven, Azure). Set "on" to force it for any other host, or
# "off" for a plaintext MySQL on a private network.
DB_SSL=                   # on | off | (blank = auto)

# ── Admin ───────────────────────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; gets role "admin" on first login

# ── Sign-in providers (all optional) ────────────────────────────────────────
# The app boots and works with NONE of these set — guest sign-in and
# email+password (see db/seed-admin.ts) always work. Each provider's button
# only appears once its credentials are present.

# Google — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple — https://developer.apple.com/account/resources/identifiers
# Return URL: https://<your-domain>/api/oauth/apple/callback
APPLE_CLIENT_ID=          # Services ID
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=        # ES256 PEM contents (raw or base64)

# Kimi OAuth — ONLY needed when hosting on Kimi. Leave both blank elsewhere;
# the "Continue with Kimi" button is then hidden automatically.
KIMI_AUTH_URL=
KIMI_OPEN_URL=
VITE_KIMI_AUTH_URL=       # same value, exposed to the browser
VITE_APP_ID=              # same as APP_ID, exposed to the browser

# ── Owner portal (optional second admin surface, api/portal-router.ts) ──────
# The portal route only exists when ALL FOUR are set. Undocumented previously.
PORTAL_PATH_SECRET=       # secret URL segment, e.g. /portal/<this>
PORTAL_ID=
PORTAL_PASSWORD=
PORTAL_SESSION_SECRET=

# ── Maps (optional) ─────────────────────────────────────────────────────────
# When set, premium users get Google map embeds. Without it the app falls back
# to free MapLibre tiles + deep links. Usage is capped at 100/user/month.
GOOGLE_MAPS_API_KEY=

# ── Affiliate partner IDs (optional — this is your revenue) ─────────────────
# Booking links carry no partner id until these are set, which means every
# outbound click currently earns nothing. Payout guide:
#   experiences 8-30% of booking value  >>  hotels 3-7%  >>  flights 1-2%
# Indian OTAs pay flat fees (~Rs 90-170/booking) and IRCTC pays nothing on
# train tickets, so route users to experiences wherever possible.
VITE_AFF_GETYOURGUIDE=    # https://partner.getyourguide.com
VITE_AFF_VIATOR=          # https://www.viator.com/partner  (also used for TripAdvisor)
VITE_AFF_KLOOK=           # https://affiliate.klook.com
VITE_AFF_BOOKING=         # https://www.booking.com/affiliate-program  (aid)

# ── Transactional email (r27, api/lib/mailer.ts) ────────────────────────────
# Optional but it unblocks THREE things at once: trip invites actually
# reaching the invitee, password reset, and any future notification mail.
# Without these the mailer logs what it would have sent and the app carries on.
RESEND_API_KEY=           # https://resend.com  (free tier: 3k emails/month)
MAIL_FROM=                # verified sender, e.g. "Wayfare <hello@wayfare.app>"
APP_URL=                  # public origin, e.g. https://wayfare.app
                          # Without it, links inside emails point at localhost.

# ── Payments (r27, Razorpay) ────────────────────────────────────────────────
# Razorpay rather than Stripe: this is an India-first product and Stripe India
# still does not support UPI. Unset means billing.createOrder refuses honestly
# instead of granting a free upgrade the way the old mock checkout did.
RAZORPAY_KEY_ID=          # https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_SECRET=
# Set this on the webhook itself in the Razorpay dashboard. It is a DIFFERENT
# secret from the API key above, and mixing them up is the usual reason
# webhook signature verification fails.
# Webhook URL:  https://<your-domain>/api/webhooks/razorpay
# Events:       payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=
